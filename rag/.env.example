# Copy to rag/.env (never commit .env). Every slug lives here; swapping a model is a config change only.

# --- Required ------------------------------------------------------------
# https://openrouter.ai/keys . No quotes, no spaces. Under 10 credits bought = 50 free calls/day.
OPENROUTER_API_KEY=

# --- Models (section 6; re-check the live lists at the start of each session) --
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
# Client-side Matryoshka truncation of the 2,048-dim vectors. Changing it requires a rebuild.
EMBED_DIMENSIONS=1024
# Stretch E3.4: embed figure images instead of captions (changes the index; rebuild).
EMBED_IMAGES=false
EMBED_BATCH_SIZE=32
VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
VISION_FALLBACKS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
FIGURE_MODEL=nvidia/nemotron-3.5-super-vl:free
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
REASONING_OFF=true
REQUESTS_PER_MINUTE=20

# --- Vector store --------------------------------------------------------
# qdrant (docker compose up -d) or memory (no Docker; persisted under data/index/)
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=manual_units

# --- Corpus ---------------------------------------------------------------
# enginuity_t2 (tier A: 12 figures + 15 tables, ~14 calls to build)
# vidore       (tier C: 4 checklists, 27 figures + ~400 text chunks, ~45 calls; adds text questions)
# enginuity_pdf (tier B: data-7.pdf routing practice, 65 figures -> mind the caption budget)
CORPORA=enginuity_t2,vidore
ENGINUITY_PDFS=data-7.pdf
VIDORE_PDFS=TO_00-25-172CL-1.pdf,TO_00-25-172CL-3.pdf,TO_00-25-172CL-4.pdf,TO_00-25-172CL-5.pdf
MAX_CAPTIONS=80
# Candidate fix to measure: prepend the figure title to its parts-list tables' search text.
LINK_TABLE_TO_FIGURE=false

# --- OCR gate ---------------------------------------------------------------
# auto = tesseract if installed, else the vision model (capped), else review queue
OCR_BACKEND=auto
OCR_MIN_CONFIDENCE=60
OCR_MAX_GARBLE=0.35
MAX_VISION_OCR_PAGES=10

# --- Retrieval / answering ----------------------------------------------------
TOP_K=5
MIN_SCORE=0.0
FUSION=false
BM25_WEIGHT=0.3
CONTEXT_UNITS=4

# --- Service -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
